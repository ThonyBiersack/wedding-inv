# Cloudflare D1 Database Configuration
DB_NAME=invitation_db
DB_ID=local-d1-invitation-db

# Cloudflare Turnstile (Anti-Spam CAPTCHA)
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Passcode (Protection for /generator & /api/guests)
ADMIN_SECRET_KEY=ganti_dengan_passcode_rahasia_admin_anda


