---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Undangan Pernikahan — Anggi & Asep',
	description = 'Undangan pernikahan Anggi dan Asep. Dengan penuh sukacita, kami mengundang Anda untuk merayakan hari istimewa kami.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#4f142b" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen overflow-x-hidden">
		<slot />
	</body>
</html>
