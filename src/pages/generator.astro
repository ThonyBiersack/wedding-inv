---
import Layout from "../layouts/layout.astro";
import BatikBackground from "../components/BatikBackground.astro";
import { getDb } from "../lib/db";
import { sanitizeText, timingSafeEqual, createSessionToken, generateSecureSlug } from "../lib/security";
import { env } from "cloudflare:workers";

export const prerender = false;

// 1. Auth Helper
function getAdminSecret(): string | null {
	try {
		if (typeof env !== "undefined" && (env as any)?.ADMIN_SECRET_KEY) {
			return (env as any).ADMIN_SECRET_KEY;
		}
	} catch {}
	return (import.meta as any).env?.ADMIN_SECRET_KEY || null;
}

const adminSecret = getAdminSecret();
const sessionCookie = Astro.cookies.get("admin_session")?.value;
let expectedSessionToken: string | null = null;
if (adminSecret) {
	expectedSessionToken = await createSessionToken(adminSecret);
}

// FAIL-CLOSED: Hanya izinkan akses jika adminSecret terpasang dan cookie token sesi valid
const isAuthenticated = Boolean(
	adminSecret &&
	sessionCookie &&
	expectedSessionToken &&
	timingSafeEqual(sessionCookie, expectedSessionToken),
);
let authError: string | null = null;
let formError: string | null = null;
let createdGuest: { name: string; slug: string; url: string } | null = null;


function buildInvitationMessage(guestName: string, guestUrl: string): string {
	return `Kepada Yth.
*${guestName}*
di Tempat

Tanpa mengurangi rasa hormat, perkenankan kami mengundang Bapak/Ibu/Saudara/i untuk menghadiri acara pernikahan kami:

*Anggi & Asep*
Minggu, 15 November 2026

Detail acara dan konfirmasi kehadiran dapat diakses melalui tautan berikut:
${guestUrl}

Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.

Terima kasih.`;
}

function getWhatsAppShareUrl(guestName: string, guestUrl: string): string {
	const text = buildInvitationMessage(guestName, guestUrl);
	return `https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`;
}

const baseUrl = Astro.url.origin;
const getGuestUrl = (slug: string) => `${baseUrl}/?to=${encodeURIComponent(slug)}`;

// 2. Server-side Action Handlers (Mutasi langsung di serverless)
if (Astro.request.method === "POST") {
	try {
		const formData = await Astro.request.formData();
		const action = formData.get("_action")?.toString();

		if (action === "login") {
			const enteredKey = formData.get("passcode")?.toString().trim();
			if (adminSecret && enteredKey && timingSafeEqual(enteredKey, adminSecret)) {
				const sessionToken = await createSessionToken(adminSecret);
				Astro.cookies.set("admin_session", sessionToken, {
					path: "/",
					httpOnly: true,
					secure: true,
					sameSite: "strict",
					maxAge: 60 * 60 * 24 * 7, // 7 hari
				});
				return Astro.redirect("/generator");
			} else {
				authError = "Passcode salah atau akses ditolak.";
			}
		} else if (action === "logout") {
			Astro.cookies.delete("admin_session", { path: "/" });
			return Astro.redirect("/generator");
		} else if (action === "add_guest") {
			if (!isAuthenticated) {
				return Astro.redirect("/generator");
			}

			const db = await getDb();
			if (!db) throw new Error("D1 Database binding tidak ditemukan.");

			const rawName = formData.get("guestName")?.toString() || "";
			const name = sanitizeText(rawName, 80);

			if (!name) {
				formError = "Nama tamu tidak boleh kosong (maksimal 80 karakter).";
			} else {
				let finalSlug = generateSecureSlug(name);
				let attempts = 0;
				while (attempts < 5) {
					const existing = await db
						.prepare("SELECT id FROM guests WHERE slug = ?")
						.bind(finalSlug)
						.first();
					if (!existing) break;
					finalSlug = generateSecureSlug(name);
					attempts++;
				}

				await db
					.prepare("INSERT INTO guests (name, slug) VALUES (?, ?)")
					.bind(name, finalSlug)
					.run();

				createdGuest = {
					name,
					slug: finalSlug,
					url: getGuestUrl(finalSlug),
				};
			}
		} else if (action === "delete_guest") {
			if (!isAuthenticated) {
				return Astro.redirect("/generator");
			}

			const db = await getDb();
			if (!db) throw new Error("D1 Database binding tidak ditemukan.");

			const guestId = Number(formData.get("guest_id"));
			if (guestId && Number.isInteger(guestId) && guestId > 0) {
				await db.prepare("DELETE FROM guests WHERE id = ?").bind(guestId).run();
			}
			return Astro.redirect("/generator");
		}
	} catch (err: any) {
		console.error("Error processing generator action:", err);
		formError = err?.message || "Terjadi kesalahan saat memproses data.";
	}
}

// 3. SSR Data Fetching (Langsung dari Cloudflare D1 di server)
interface Guest {
	id: number;
	name: string;
	slug: string;
	status_rsvp?: string;
	wishes?: string;
	created_at?: string;
}

let guests: Guest[] = [];
if (isAuthenticated) {
	try {
		const db = await getDb();
		if (db) {
			const { results } = await db
				.prepare("SELECT * FROM guests ORDER BY id DESC")
				.all<Guest>();
			guests = results ?? [];
		}
	} catch (e) {
		console.error("Gagal mengambil daftar tamu di server:", e);
	}
}
---

<Layout title="Generator Undangan & Tamu · Anggi & Asep">
	<div class="relative min-h-screen bg-[#241018] text-[#fff7f9] selection:bg-[#c4a252] selection:text-[#241018]">
