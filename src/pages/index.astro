---
import Layout from "../layouts/layout.astro";
import BatikBackground from "../components/BatikBackground.astro";
import InvitationCover from "../components/InvitationCover.astro";
import InvitationVerse from "../components/InvitationVerse.astro";
import InvitationProfiles from "../components/InvitationProfiles.astro";
import InvitationLoveStory from "../components/InvitationLoveStory.astro";
import InvitationEventDetails from "../components/InvitationEventDetails.astro";
import InvitationGallery from "../components/InvitationGallery.astro";
import InvitationGift from "../components/InvitationGift.astro";
import InvitationRsvp from "../components/InvitationRsvp.astro";
import InvitationWishes from "../components/InvitationWishes.astro";
import InvitationClosing from "../components/InvitationClosing.astro";
import { getDb } from "../lib/db";

export const prerender = false;

const toParam = Astro.url.searchParams.get("to")?.trim() || "";
let verifiedGuest: { id: number; name: string; slug: string } | null = null;

if (toParam) {
	try {
		const db = await getDb();
		if (db) {
			const record = await db
				.prepare("SELECT id, name, slug FROM guests WHERE slug = ?")
				.bind(toParam)
				.first<{ id: number; name: string; slug: string }>();
			if (record) {
				verifiedGuest = record;
			}
		}
	} catch (e) {
		console.error("Gagal validasi tamu di server:", e);
	}
}

const guestDisplayName = verifiedGuest ? verifiedGuest.name : "Tamu Undangan";
const guestSlug = verifiedGuest ? verifiedGuest.slug : "";
const isRegisteredGuest = Boolean(verifiedGuest);

const photos = [
	"IMG_20261014_194408.webp",
	"IMG_20261014_194330.webp",
	"IMG_20261014_194238.webp",
	"IMG_20261014_194145.webp",
	"DSC088233.webp",
	"DSC08812.webp",
	"DSC08810.webp",
	"DSC08804.webp",
	"DSC08799.webp",
	"DSC08790.webp",
	"DSC08789.webp",
	"DSC087833.webp",
	"DSC087666.webp",
	"DSC08740.webp",
];
---

<Layout>
	<main
		id="main-stage"
		data-registered={isRegisteredGuest ? "true" : "false"}
		data-guest-name={guestDisplayName}
		data-guest-slug={guestSlug}
		class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-5 py-12"
	>
		<BatikBackground />

		<header id="main-header" class="page-header relative z-10 mb-9 text-center sm:mb-12">
			<p
				class="mb-3 font-sans text-[10px] font-medium uppercase tracking-[0.38em] text-[#e4d3a0] sm:text-xs"
			>
				Sebuah undangan istimewa
			</p>
			<h1
				class="text-4xl font-normal tracking-tight text-[#fff0f4] sm:text-5xl"
			>
				Anggi <span class="font-light italic text-[#c4a252]">&amp;</span
				> Asep
			</h1>
			<p
				class="mt-3 font-sans text-[10px] uppercase tracking-[0.32em] text-[#e4d3a0]"
			>
				15 · 11 · 2026
			</p>
		</header>

		<section
			id="invitation-section"
			class="relative z-10 flex w-full max-w-md flex-col items-center"
			aria-label="Undangan pernikahan"
		>
			<div
				id="envelope"
				class="envelope-stage relative aspect-[1.3/1] w-full max-w-[25rem]"
			>
				<!-- Interior Dinding Belakang Amplop -->
				<div class="envelope-back absolute inset-0 overflow-hidden rounded-sm">
					<div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/25"></div>
				</div>

				<!-- Flap Wrapper 3D: Membawa segitiga flap dan segel berputar realistis 180° ke atas -->
				<div
					class="envelope-flap-wrapper absolute inset-x-0 top-0 h-[56%] pointer-events-none"
				>
					<!-- Sisi Luar Flap (Tampak saat tertutup) -->
					<div class="envelope-flap-front absolute inset-0">
						<div
							class="envelope-flap-shape absolute inset-0 bg-gradient-to-b from-[#f0dfb2] to-[#cbb274] [clip-path:polygon(0_0,100%_0,50%_100%)]"
							aria-hidden="true"
						>
							<svg
								aria-hidden="true"
								class="pointer-events-none absolute inset-0 h-full w-full"
								viewBox="0 0 1000 550"
								preserveAspectRatio="none"
							>
								<path
									d="M 0 0 L 500 550 L 1000 0"
									fill="none"
									stroke="#6e1d3b"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="8"
									opacity="0.5"></path>
							</svg>
						</div>

						<!-- Tombol Segel Lilin Menempel di Ujung Segitiga Flap -->
						<button
							id="open-invitation"
							type="button"
							aria-label="Buka surat undangan"
							aria-expanded="false"
							aria-controls="invitation"
							class="envelope-seal pointer-events-auto absolute bottom-0 left-1/2 z-30 flex h-13 w-13 -translate-x-1/2 translate-y-1/2 cursor-pointer items-center justify-center rounded-full border-2 border-[#e4d3a0] bg-gradient-to-br from-[#7e2444] to-[#4f142b] text-[#e4d3a0] shadow-[0_4px_14px_rgba(79,20,43,0.55)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#e4d3a0]"
						>
							<div
								class="relative flex h-10 w-10 items-center justify-center rounded-full border border-[#c4a252] bg-[#3a0d1e]/80 shadow-inner"
							>
								<svg
									class="h-5 w-5 drop-shadow-[0_1px_2px_rgba(0,0,0,0.5)]"
									viewBox="0 0 24 24"
									fill="url(#gold-heart-gradient)"
									stroke="#e4d3a0"
									stroke-width="1.2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<defs>
										<linearGradient
											id="gold-heart-gradient"
											x1="0%"
											y1="0%"
											x2="100%"
											y2="100%"
										>
											<stop offset="0%" stop-color="#fff0d0"
											></stop>
											<stop offset="50%" stop-color="#e4d3a0"
											></stop>
											<stop offset="100%" stop-color="#c4a252"
											></stop>
										</linearGradient>
									</defs>
									<path
										d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
									></path>
								</svg>
							</div>
						</button>

						<!-- Efek Kilatan Emas Pelepasan Segel -->
						<div
							id="seal-sparkle"
							class="pointer-events-none absolute bottom-0 left-1/2 z-35 h-14 w-14 -translate-x-1/2 translate-y-1/2 rounded-full border-2 border-[#e4d3a0] opacity-0 scale-50 transition-all duration-500 ease-out"
						>
						</div>
					</div>

					<!-- Sisi Dalam Flap (Lining emas mewah tampak saat terbuka) -->
					<div class="envelope-flap-back absolute inset-0">
						<div
							class="envelope-flap-shape absolute inset-0 bg-gradient-to-t from-[#8f6e24] via-[#ab8634] to-[#785b1a] [clip-path:polygon(0_0,100%_0,50%_100%)]"
							aria-hidden="true"
						>
							<svg
								aria-hidden="true"
								class="pointer-events-none absolute inset-0 h-full w-full opacity-40"
								viewBox="0 0 1000 550"
								preserveAspectRatio="none"
							>
								<path
									d="M 60 20 L 500 510 L 940 20"
									fill="none"
									stroke="#e4d3a0"
									stroke-dasharray="8 6"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="3"></path>
							</svg>
						</div>
					</div>
				</div>

				<article
					id="invitation"
					aria-hidden="true"
					tabindex="-1"
					inert
					class="invitation-letter absolute bottom-4 inset-x-0 mx-auto z-10 flex h-[92%] w-[84%] flex-col items-center justify-start rounded-md bg-[#f4d7e0] px-0 py-5 text-center shadow-[0_10px_25px_-5px_rgba(0,0,0,0.45)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#c4a252]"
				>
					<div
						class="relative z-[1] flex w-full flex-col items-center gap-0"
					>
						<audio
							id="invitation-music"
							src="/audio/Make%20You%20Feel%20My%20Love.mp3"
							preload="none"
							loop
							hidden></audio>
						<InvitationCover guestName={guestDisplayName} />

						<InvitationVerse />

						<InvitationProfiles />

						<InvitationLoveStory />

						<InvitationEventDetails />

						<InvitationGallery photos={photos} />

						<InvitationGift />

						<InvitationRsvp />

						<InvitationWishes />

						<InvitationClosing />
					</div>
				</article>

				<div
					class="envelope-front absolute inset-0 z-20 overflow-hidden rounded-sm pointer-events-none"
				>
					<svg
						aria-hidden="true"
						class="pointer-events-none absolute inset-0 h-full w-full"
						viewBox="0 0 1000 770"
						preserveAspectRatio="none"
					>
						<!-- Sayap Kiri Samping -->
						<polygon points="0,0 500,420 0,770" fill="#b8933b"
						></polygon>
						<!-- Sayap Kanan Samping -->
						<polygon points="1000,0 500,420 1000,770" fill="#b8933b"
						></polygon>
						<!-- Flap Depan Bawah Segitiga (Puncaknya mengarah ke ATAS di tengah) -->
						<polygon points="0,770 500,420 1000,770" fill="#c4a252"
						></polygon>
						<!-- Garis lipatan sambungan emas & maroon -->
						<path
							d="M 0 0 L 500 420 L 1000 0"
							fill="none"
							stroke="#4f142b"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="5"
							opacity="0.35"></path>
						<path
							d="M 0 770 L 500 420 L 1000 770"
							fill="none"
							stroke="#e4d3a0"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="3"
							opacity="0.65"></path>
					</svg>
					<div
						class="absolute inset-x-8 bottom-[10%] z-[1] text-center text-[#4f142b]"
					>
						<p
							class="font-sans text-[8px] uppercase tracking-[0.24em] text-[#4f142b]"
						>
							Kepada Yth.
						</p>
						<p
							id="recipient-name"
							class="mt-1 break-words font-serif text-[17px] font-bold leading-tight tracking-wide text-[#3a0d1e] sm:text-lg"
						>
							{guestDisplayName}
						</p>
					</div>
				</div>
			</div>

			<p
				id="envelope-hint"
				class="mt-11 font-sans text-[9px] uppercase tracking-[0.18em] text-[#f4d7e0] sm:mt-14"
			>
				Klik segel untuk membuka
			</p>
		</section>

		<!-- Floating Music Controller Widget -->
		<button
			id="music-toggle-btn"
			type="button"
			aria-label="Jeda atau putar musik latar"
			class="fixed bottom-5 right-5 z-[70] hidden h-11 w-11 items-center justify-center rounded-full border-2 border-[#c4a252] bg-[#3a0d1e]/90 text-[#e4d3a0] shadow-xl backdrop-blur-md transition hover:scale-105 active:scale-95 sm:bottom-6 sm:right-6"
		>
			<svg
				id="music-disc-icon"
				class="h-5 w-5 animate-spin-slow text-[#c4a252]"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
			>
				<circle cx="12" cy="12" r="10"></circle>
				<circle cx="12" cy="12" r="3"></circle>
				<path d="M12 2a10 10 0 0 1 10 10"></path>
			</svg>
			<svg
				id="music-paused-icon"
				class="hidden h-5 w-5 text-[#f4d7e0]/70"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<line x1="1" y1="1" x2="23" y2="23"></line>
				<path
					d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V4m0 0l4 2.5M15 4v1.5"
				></path>
				<circle cx="12" cy="12" r="10"></circle>
			</svg>
		</button>

		<footer
			id="main-footer"
			class="page-footer relative z-10 mt-12 font-sans text-[9px] tracking-[0.12em] text-[#e4d3a0] sm:mt-16"
		>
			MERAYAKAN CINTA · 2026
		</footer>
	</main>

	<script>
		const envelope = document.querySelector("#envelope");
		const invitation = document.querySelector("#invitation");
		const button = document.querySelector("#open-invitation");
		const envelopeHint = document.querySelector("#envelope-hint");
		const recipientName = document.querySelector("#recipient-name");
		const coverRecipientName = document.querySelector(
			"#cover-recipient-name",
		);
		const invitationMusic = document.querySelector("#invitation-music");
		const rsvpForm = document.querySelector("#rsvp-form");
		const guestWishes = document.querySelector("#guest-wishes");
		const wishList = document.querySelector("#wish-list");

		if (
			!(envelope instanceof HTMLElement) ||
			!(invitation instanceof HTMLElement) ||
			!(button instanceof HTMLButtonElement) ||
			!(envelopeHint instanceof HTMLElement) ||
			!(recipientName instanceof HTMLElement) ||
			!(coverRecipientName instanceof HTMLElement) ||
			!(invitationMusic instanceof HTMLAudioElement) ||
			!(rsvpForm instanceof HTMLFormElement) ||
			!(guestWishes instanceof HTMLElement) ||
			!(wishList instanceof HTMLElement)
		) {
			throw new Error("Invitation elements could not be initialized.");
		}

		const mainStage = document.querySelector("#main-stage");
		const isRegistered = mainStage?.getAttribute("data-registered") === "true";
		const registeredGuestName = mainStage?.getAttribute("data-guest-name") || "Tamu Undangan";
		const registeredGuestSlug = mainStage?.getAttribute("data-guest-slug") || "";

		const guestNameInput = document.querySelector("#guest-name");
		const lockedGuestBadge = document.querySelector("#locked-guest-badge");
		const rsvpSubmitBtn = rsvpForm.querySelector("button[type='submit']");

		if (isRegistered && registeredGuestSlug) {
			recipientName.textContent = registeredGuestName;
			coverRecipientName.textContent = registeredGuestName;

			if (guestNameInput instanceof HTMLInputElement) {
				guestNameInput.value = registeredGuestName;
				guestNameInput.readOnly = true;
				if (lockedGuestBadge instanceof HTMLElement) {
					lockedGuestBadge.classList.remove("hidden");
				}
			}
		} else {
			recipientName.textContent = "Tamu Undangan";
			coverRecipientName.textContent = "Tamu Undangan";
			if (guestNameInput instanceof HTMLInputElement) {
				guestNameInput.value = "";
				guestNameInput.readOnly = false;
				guestNameInput.placeholder = "Hanya tamu resmi yang dapat mengisi RSVP";
				guestNameInput.disabled = true;
			}
			if (rsvpSubmitBtn instanceof HTMLButtonElement) {
				rsvpSubmitBtn.disabled = true;
				rsvpSubmitBtn.classList.add("opacity-50", "cursor-not-allowed");
				rsvpSubmitBtn.title = "Gunakan tautan undangan resmi untuk mengisi RSVP.";
			}
			if (lockedGuestBadge instanceof HTMLElement) {
				lockedGuestBadge.textContent = "Khusus Tamu Terdaftar";
				lockedGuestBadge.classList.remove("hidden");
			}
		}

		const renderWishCard = (nameStr: string, attendanceStr: string, msgStr: string) => {
			const card = document.createElement("article");
			card.className =
				"rounded-xl border border-[#c4a252]/60 bg-gradient-to-b from-[#fff7f9] to-[#f4d7e0] p-3.5 text-left shadow-2xs";

			const headerEl = document.createElement("div");
			headerEl.className = "flex items-start justify-between gap-2.5";

			const nameEl = document.createElement("h3");
			nameEl.className = "min-w-0 flex-1 break-words font-serif text-[15px] font-bold leading-snug tracking-wide text-[#3a0d1e] sm:text-base";
			nameEl.textContent = nameStr;

			const isPresent = attendanceStr.trim().toUpperCase() === "HADIR";

			const responseEl = document.createElement("span");
			responseEl.className = isPresent
				? "shrink-0 rounded-full border border-[#b38e2d] bg-gradient-to-r from-[#e5c158] to-[#c4a252] px-2.5 py-0.5 font-sans text-[8px] font-bold uppercase tracking-wider text-[#1a0a10] shadow-xs"
				: "shrink-0 rounded-full border border-[#3a0d1e] bg-[#4f142b] px-2.5 py-0.5 font-sans text-[8px] font-medium uppercase tracking-wider text-white shadow-xs";
			responseEl.textContent = isPresent ? "Hadir" : "Tidak Hadir";

			headerEl.append(nameEl, responseEl);

			const wishEl = document.createElement("p");
			wishEl.className =
				"mt-2 whitespace-pre-wrap break-words font-sans text-xs leading-relaxed text-[#4f142b]/90";
			wishEl.textContent = msgStr;

			card.append(headerEl, wishEl);
			return card;
		};

		// Muat riwayat ucapan dari Cloudflare D1
		fetch("/api/rsvp")
			.then((res) => res.json())
			.then((wishes: Array<{ name: string; status_rsvp: string; wishes: string }>) => {
				if (Array.isArray(wishes) && wishes.length > 0) {
					wishes.forEach((w) => {
						if (w.wishes && w.name) {
							const card = renderWishCard(w.name, w.status_rsvp || "Hadir", w.wishes);
							wishList.appendChild(card);
						}
					});
					guestWishes.classList.remove("hidden");
				}
			})
			.catch(() => {});

		const rsvpFeedback = document.querySelector("#rsvp-feedback");
		const rsvpBtnText = document.querySelector("#rsvp-btn-text");
		const rsvpSpinner = document.querySelector("#rsvp-spinner");

		const showFeedback = (msg: string, isError = false) => {
			if (!rsvpFeedback) return;
			rsvpFeedback.textContent = msg;
			rsvpFeedback.className = isError
				? "block rounded-xl border border-rose-300 bg-rose-50/90 p-2.5 text-center font-sans text-xs font-medium text-rose-800"
				: "block rounded-xl border border-emerald-300 bg-emerald-50/90 p-2.5 text-center font-sans text-xs font-medium text-emerald-800";
		};

		rsvpForm.addEventListener("submit", async (event) => {
			event.preventDefault();

			if (!isRegistered || !registeredGuestSlug) {
				showFeedback("Akses ditolak: Hanya tamu yang memiliki tautan resmi terdaftar yang dapat mengisi RSVP.", true);
				return;
			}

			const formData = new FormData(rsvpForm);
			const attendance = formData.get("attendance");
			const message = formData.get("message");
			const honeypot = formData.get("website");
			const turnstileToken = formData.get("cf-turnstile-response");

			if (typeof attendance !== "string" || typeof message !== "string") {
				showFeedback("Mohon lengkapi kehadiran dan pesan.", true);
				return;
			}

			// Anti-Double Click / Loading State
			if (rsvpSubmitBtn instanceof HTMLButtonElement) {
				rsvpSubmitBtn.disabled = true;
			}
			rsvpBtnText?.classList.add("opacity-60");
			rsvpSpinner?.classList.remove("hidden");

			try {
				const res = await fetch("/api/rsvp", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						attendance,
						message: message.trim(),
						slug: registeredGuestSlug,
						website: honeypot || "",
						"cf-turnstile-response": turnstileToken || "",
					}),
				});

				const resData = await res.json().catch(() => ({}));

				if (!res.ok) {
					showFeedback(resData.error || "Gagal menyimpan RSVP.", true);
					return;
				}

				showFeedback("Terima kasih! Konfirmasi kehadiran dan doa Anda telah tersimpan.");

				const card = renderWishCard(resData.guestName || registeredGuestName, attendance, message.trim());
				wishList.prepend(card);
				guestWishes.classList.remove("hidden");

				rsvpForm.reset();
				if (guestNameInput instanceof HTMLInputElement) {
					guestNameInput.value = registeredGuestName;
					guestNameInput.readOnly = true;
				}

				// Reset Cloudflare Turnstile widget jika terpasang
				if (typeof (window as any).turnstile?.reset === "function") {
					try {
						(window as any).turnstile.reset();
					} catch {}
				}

				guestWishes.scrollIntoView({
					behavior: "smooth",
					block: "nearest",
				});
			} catch (err) {
				console.error("Gagal simpan RSVP ke D1:", err);
				showFeedback("Terjadi kesalahan jaringan. Silakan coba lagi.", true);
			} finally {
				if (rsvpSubmitBtn instanceof HTMLButtonElement && isRegistered) {
					rsvpSubmitBtn.disabled = false;
				}
				rsvpBtnText?.classList.remove("opacity-60");
				rsvpSpinner?.classList.add("hidden");
			}
		});

		const mainHeader = document.querySelector("#main-header");
		const mainFooter = document.querySelector("#main-footer");
		const delay = (ms: number) =>
			new Promise((resolve) => setTimeout(resolve, ms));

		const musicToggleBtn = document.querySelector("#music-toggle-btn");
		const musicDiscIcon = document.querySelector("#music-disc-icon");
		const musicPausedIcon = document.querySelector("#music-paused-icon");

		const updateMusicUi = (isPlaying: boolean) => {
			if (isPlaying) {
				musicDiscIcon?.classList.remove("hidden");
				musicDiscIcon?.classList.add("animate-spin-slow");
				musicPausedIcon?.classList.add("hidden");
				musicToggleBtn?.setAttribute("aria-label", "Jeda musik");
			} else {
				musicDiscIcon?.classList.add("hidden");
				musicDiscIcon?.classList.remove("animate-spin-slow");
				musicPausedIcon?.classList.remove("hidden");
				musicToggleBtn?.setAttribute("aria-label", "Putar musik");
			}
		};

		if (musicToggleBtn instanceof HTMLButtonElement) {
			musicToggleBtn.addEventListener("click", () => {
				if (invitationMusic.paused) {
					void invitationMusic.play().catch((error: unknown) => {
						console.error("Unable to play invitation audio.", error);
					});
					updateMusicUi(true);
				} else {
					invitationMusic.pause();
					updateMusicUi(false);
				}
			});
		}

		let wasPlayingBeforeHidden = false;

		document.addEventListener("visibilitychange", () => {
			if (document.hidden) {
				if (!invitationMusic.paused) {
					wasPlayingBeforeHidden = true;
					invitationMusic.pause();
					updateMusicUi(false);
				} else {
					wasPlayingBeforeHidden = false;
				}
			} else if (wasPlayingBeforeHidden) {
				void invitationMusic.play().catch((error: unknown) => {
					console.error("Unable to resume invitation audio.", error);
				});
				updateMusicUi(true);
				wasPlayingBeforeHidden = false;
			}
		});

		button.addEventListener("click", async () => {
			button.disabled = true;
			button.setAttribute("aria-expanded", "true");

			// 1. Mulai audio musik secara bertahap
			invitationMusic.volume = 0;
			void invitationMusic
				.play()
				.then(() => {
					const fadeInterval = setInterval(() => {
						if (invitationMusic.volume < 0.95) {
							invitationMusic.volume = Math.min(
								1,
								invitationMusic.volume + 0.1,
							);
						} else {
							invitationMusic.volume = 1;
							clearInterval(fadeInterval);
						}
					}, 60);
				})
				.catch((error: unknown) => {
					console.error("Unable to play invitation audio.", error);
				});

			// 2. Sentuhan haptik segel & kilatan emas
			button.classList.add("is-clicked");
			const sealSparkle = document.querySelector("#seal-sparkle");
			if (sealSparkle instanceof HTMLElement) {
				sealSparkle.classList.remove("scale-50", "opacity-0");
				sealSparkle.classList.add("scale-[2.4]", "opacity-100");
				setTimeout(() => {
					sealSparkle.classList.remove("opacity-100");
					sealSparkle.classList.add("opacity-0");
				}, 500);
			}

			envelopeHint.textContent = "Membuka undangan...";
			mainHeader?.classList.add("is-hidden");
			mainFooter?.classList.add("is-hidden");

			// 3. Flap membuka 180° ke atas dengan 3D perspective
			envelope.classList.add("is-flap-open");

			// 4. Overlapping: saat flap mencapai ~120° (550ms), surat langsung mulai meluncur keluar secara alami
			await delay(550);
			envelope.classList.add("is-sliding-out");

			// 5. Surat mencapai puncak ketinggian kantong (durasi 850ms), beri jeda napas 500ms agar tamu menikmati
			await delay(950);

			// 6. Transisi sinematik: amplop mundur/turun ke bawah, surat bergerak maju mendekat ke mata pembaca
			const startRect = invitation.getBoundingClientRect();

			envelope.classList.add("is-open");

			const targetRect = invitation.getBoundingClientRect();

			button.setAttribute("aria-label", "Surat terbuka");
			invitation.setAttribute("aria-hidden", "false");
			invitation.setAttribute("tabindex", "0");
			invitation.inert = false;
			invitation.setAttribute(
				"aria-label",
				"Surat undangan lengkap. Gulir untuk melihat semua bagian.",
			);
			invitation.focus({ preventScroll: true });
			invitation.scrollTop = 0;

			if (musicToggleBtn instanceof HTMLButtonElement) {
				musicToggleBtn.classList.remove("hidden");
			}

			const deltaX =
				startRect.left +
				startRect.width / 2 -
				(targetRect.left + targetRect.width / 2);
			const deltaY =
				startRect.top +
				startRect.height / 2 -
				(targetRect.top + targetRect.height / 2);
			const scaleX = startRect.width / targetRect.width;
			const scaleY = startRect.height / targetRect.height;

			// Eksekusi animasi zoom-in simetris dari posisi tengah ke fullscreen
			const anim = invitation.animate(
				[
					{
						transformOrigin: "center center",
						transform: `translate3d(${deltaX}px, ${deltaY}px, 0) scale(${scaleX}, ${scaleY})`,
						boxShadow: "0 20px 45px -6px rgba(0, 0, 0, 0.55)",
					},
					{
						transformOrigin: "center center",
						transform: "translate3d(0px, 0px, 0) scale(1, 1)",
						boxShadow: "0 24px 45px rgba(66, 53, 39, 0.18)",
					},
				],
				{
					duration: 850,
					easing: "cubic-bezier(0.16, 1, 0.3, 1)",
					fill: "both",
				},
			);

			anim.onfinish = () => {
				envelope.classList.remove("is-sliding-out");
				invitation.classList.add("is-scrollable");
				invitation.scrollTop = 0;
				envelopeHint.textContent = "";
			};
		});
	</script>
</Layout>
