---

---

<section
	class="w-full bg-[#fff7f9]/45 p-4 sm:p-6"
	aria-labelledby="gift-heading"
>
	<h2
		id="gift-heading"
		class="font-sans text-[10px] font-semibold uppercase tracking-[0.28em] text-[#a37d2c] sm:text-xs"
	>
		Wedding Gift
	</h2>

	<!-- Single Unified Luxury Container (Maroon & Gold Gradient) -->
	<div
		class="relative mt-5 overflow-hidden rounded-2xl border border-[#c4a252]/70 bg-gradient-to-b from-[#4f142b] via-[#5c1731] to-[#3a0d1e] p-5 sm:p-7 shadow-lg text-[#e4d3a0]"
	>
		<!-- Background Floral Watermark Corner Accents -->
		<div
			class="pointer-events-none absolute -top-5 -right-5 h-20 w-20 opacity-20"
		>
			<svg
				viewBox="0 0 100 100"
				fill="none"
				stroke="#c4a252"
				stroke-width="1.2"
			>
				<path
					d="M50 10 C60 30 70 30 90 50 C70 70 70 70 50 90 C30 70 30 70 10 50 C30 30 40 30 50 10 Z"
				></path>
				<circle cx="50" cy="50" r="16"></circle>
				<path d="M20 20 Q50 35 80 20"></path>
				<path d="M20 80 Q50 65 80 80"></path>
			</svg>
		</div>
		<div
			class="pointer-events-none absolute -bottom-5 -left-5 h-20 w-20 opacity-20 rotate-180"
		>
			<svg
				viewBox="0 0 100 100"
				fill="none"
				stroke="#c4a252"
				stroke-width="1.2"
			>
				<path
					d="M50 10 C60 30 70 30 90 50 C70 70 70 70 50 90 C30 70 30 70 10 50 C30 30 40 30 50 10 Z"
				></path>
				<circle cx="50" cy="50" r="16"></circle>
				<path d="M20 20 Q50 35 80 20"></path>
				<path d="M20 80 Q50 65 80 80"></path>
			</svg>
		</div>

		<div class="relative z-10 flex flex-col items-center text-center">
			<!-- Bagian 1: Bank BRI -->
			<div class="flex flex-col items-center w-full">
				<!-- Icon Bank / Kartu SVG -->
				<div
					class="flex h-10 w-10 items-center justify-center rounded-full border border-[#c4a252]/70 bg-[#3a0d1e] text-[#c4a252] shadow-xs"
				>
					<svg
						class="h-4.5 w-4.5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="2" y="5" width="20" height="14" rx="2"></rect>
						<line x1="2" y1="10" x2="22" y2="10"></line>
					</svg>
				</div>
				<p
					class="mt-2.5 font-sans text-[9px] font-semibold uppercase tracking-[0.2em] text-[#c4a252]"
				>
					Bank BRI
				</p>
				<p
					class="mt-1 font-serif text-lg font-medium tracking-wider text-[#fff0f4] sm:text-xl"
				>
					080701053563534
				</p>
				<p class="mt-0.5 font-sans text-[11px] text-[#e4d3a0]/85">
					a.n. Asep Hidayat
				</p>
				<button
					type="button"
					class="copy-btn mt-3 inline-flex items-center gap-1.5 rounded-full border border-[#c4a252]/80 bg-[#c4a252]/15 px-3.5 py-1 font-sans text-[9px] font-medium tracking-wider text-[#e4d3a0] shadow-2xs backdrop-blur-xs transition hover:bg-[#c4a252]/30 hover:border-[#e4d3a0] hover:text-[#fff0f4] active:scale-95"
					data-copy="080701053563534"
					aria-label="Salin nomor rekening Bank BRI"
				>
					<svg
						class="h-3 w-3 text-[#c4a252]"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="9" y="9" width="13" height="13" rx="2" ry="2"
						></rect>
						<path
							d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
						></path>
					</svg>
					<span>Salin No. Rekening</span>
				</button>
			</div>

			<!-- Divider Ornamen SVG Pemisah 1 -->
			<div
				class="relative my-5 flex w-full max-w-[220px] items-center justify-center"
			>
				<div aria-hidden="true" class="h-px w-full bg-[#c4a252]/30">
				</div>
				<div
					class="absolute bg-[#3a0d1e] px-3 font-serif text-xs text-[#c4a252]"
				>
					✦ ❖ ✦
				</div>
			</div>

			<!-- Bagian 2: DANA -->
			<div class="flex flex-col items-center w-full">
				<!-- Icon E-Wallet / HP SVG -->
				<div
					class="flex h-10 w-10 items-center justify-center rounded-full border border-[#c4a252]/70 bg-[#3a0d1e] text-[#c4a252] shadow-xs"
				>
					<svg
						class="h-4.5 w-4.5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="5" y="2" width="14" height="20" rx="2"></rect>
						<line x1="12" y1="18" x2="12.01" y2="18"></line>
					</svg>
				</div>
				<p
					class="mt-2.5 font-sans text-[9px] font-semibold uppercase tracking-[0.2em] text-[#c4a252]"
				>
					DANA
				</p>
				<p
					class="mt-1 font-serif text-lg font-medium tracking-wider text-[#fff0f4] sm:text-xl"
				>
					085781132254
				</p>
				<p class="mt-0.5 font-sans text-[11px] text-[#e4d3a0]/85">
					a.n. Rizva Anggi
				</p>
				<button
					type="button"
					class="copy-btn mt-3 inline-flex items-center gap-1.5 rounded-full border border-[#c4a252]/80 bg-[#c4a252]/15 px-3.5 py-1 font-sans text-[9px] font-medium tracking-wider text-[#e4d3a0] shadow-2xs backdrop-blur-xs transition hover:bg-[#c4a252]/30 hover:border-[#e4d3a0] hover:text-[#fff0f4] active:scale-95"
					data-copy="085781132254"
					aria-label="Salin nomor DANA"
				>
					<svg
						class="h-3 w-3 text-[#c4a252]"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="9" y="9" width="13" height="13" rx="2" ry="2"
						></rect>
						<path
							d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
						></path>
					</svg>
					<span>Salin No. DANA</span>
				</button>
			</div>

			<!-- Divider Ornamen SVG Pemisah 2 -->
			<div
				class="relative my-5 flex w-full max-w-[220px] items-center justify-center"
			>
				<div aria-hidden="true" class="h-px w-full bg-[#c4a252]/30">
				</div>
				<div
					class="absolute bg-[#3a0d1e] px-3 font-serif text-xs text-[#c4a252]"
				>
					✦ ❖ ✦
				</div>
			</div>

			<!-- Bagian 3: Kirim Kado Fisik -->
			<div class="flex flex-col items-center w-full">
				<!-- Icon Gift Box SVG -->
				<div
					class="flex h-10 w-10 items-center justify-center rounded-full border border-[#c4a252]/70 bg-[#3a0d1e] text-[#c4a252] shadow-xs"
				>
					<svg
						class="h-4.5 w-4.5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<polyline points="20 12 20 22 4 22 4 12"></polyline>
						<rect x="2" y="7" width="20" height="5"></rect>
						<line x1="12" y1="22" x2="12" y2="7"></line>
						<path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"
						></path>
						<path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"
						></path>
					</svg>
				</div>
				<p
					class="mt-2.5 font-sans text-[9px] font-semibold uppercase tracking-[0.2em] text-[#c4a252]"
				>
					Kirim Kado Fisik
				</p>
				<p
					class="mt-1 max-w-xs font-sans text-xs leading-relaxed text-[#fff0f4] sm:text-[13px]"
				>
					Kp. Batu Kembar RT 02 / RW 03, Desa Ciderum, Kec. Caringin,
					Kab. Bogor
				</p>
				<p class="mt-0.5 font-sans text-[11px] text-[#e4d3a0]/85">
					Penerima: a.n. Anggi &amp; Asep
				</p>
				<button
					type="button"
					class="copy-btn mt-3 inline-flex items-center gap-1.5 rounded-full border border-[#c4a252]/80 bg-[#c4a252]/15 px-3.5 py-1 font-sans text-[9px] font-medium tracking-wider text-[#e4d3a0] shadow-2xs backdrop-blur-xs transition hover:bg-[#c4a252]/30 hover:border-[#e4d3a0] hover:text-[#fff0f4] active:scale-95"
					data-copy="Kp. Batu Kembar RT 02 / RW 03, Desa Ciderum, Kec. Caringin, Kab. Bogor (Penerima: Anggi & Asep)"
					aria-label="Salin alamat pengiriman kado"
				>
					<svg
						class="h-3 w-3 text-[#c4a252]"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="9" y="9" width="13" height="13" rx="2" ry="2"
						></rect>
						<path
							d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
						></path>
					</svg>
					<span>Salin Alamat</span>
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	const copyButtons =
		document.querySelectorAll<HTMLButtonElement>(".copy-btn");
	copyButtons.forEach((btn) => {
		btn.addEventListener("click", async () => {
			const textToCopy = btn.getAttribute("data-copy");
			if (!textToCopy) return;

			try {
				if (navigator.clipboard && window.isSecureContext) {
					await navigator.clipboard.writeText(textToCopy);
				} else {
					const textArea = document.createElement("textarea");
					textArea.value = textToCopy;
					textArea.style.position = "fixed";
					textArea.style.opacity = "0";
					document.body.appendChild(textArea);
					textArea.focus();
					textArea.select();
					document.execCommand("copy");
					textArea.remove();
				}

				const labelSpan = btn.querySelector("span");
				if (labelSpan) {
					const originalText = labelSpan.textContent;
					labelSpan.textContent = "Tersalin ✓";
					btn.classList.add(
						"bg-[#c4a252]/40",
						"border-[#e4d3a0]",
						"text-[#fff0f4]",
					);
					setTimeout(() => {
						labelSpan.textContent = originalText;
						btn.classList.remove(
							"bg-[#c4a252]/40",
							"border-[#e4d3a0]",
							"text-[#fff0f4]",
						);
					}, 2000);
				}
			} catch (err) {
				console.error("Gagal menyalin teks:", err);
			}
		});
	});
</script>
