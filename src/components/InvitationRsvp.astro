<section class="w-full bg-[#fff7f9]/45 p-4 text-left sm:p-6" aria-labelledby="rsvp-heading">
	<h2 id="rsvp-heading" class="text-center font-sans text-[10px] font-semibold uppercase tracking-[0.28em] text-[#6e1d3b] sm:text-xs">
		Konfirmasi Kehadiran
	</h2>
	<p class="mt-2 text-center font-sans text-[10px] leading-relaxed text-[#6e1d3b]">
		Beri kabar kehadiran dan tinggalkan ucapan untuk Anggi &amp; Asep.
	</p>
	<form id="rsvp-form" class="mt-4 space-y-3">
		<div>
			<label for="guest-name" class="mb-1 block font-sans text-[10px] font-medium text-[#4f142b]">
				Nama
			</label>
			<input
				id="guest-name"
				name="guestName"
				type="text"
				maxlength="80"
				autocomplete="name"
				required
				class="w-full rounded-sm border border-[#c4a252]/70 bg-[#fff7f9] px-3 py-2 font-sans text-xs text-[#4f142b] outline-none transition placeholder:text-[#8c4059]/60 focus:border-[#6e1d3b] focus:ring-2 focus:ring-[#c4a252]/40"
				placeholder="Nama Anda"
			/>
		</div>

		<fieldset>
			<legend class="mb-2 font-sans text-[10px] font-medium text-[#4f142b]">
				konfirmasi kehadiran?
			</legend>
			<div class="grid grid-cols-2 gap-2">
				<label class="flex cursor-pointer items-center gap-2 rounded-sm border border-[#c4a252]/70 bg-[#fff7f9] px-3 py-2 font-sans text-[10px] text-[#4f142b] has-[:checked]:border-[#6e1d3b] has-[:checked]:bg-[#f4d7e0]">
					<input class="accent-[#6e1d3b]" type="radio" name="attendance" value="Hadir" required />
					<span>hadir</span>
				</label>
				<label class="flex cursor-pointer items-center gap-2 rounded-sm border border-[#c4a252]/70 bg-[#fff7f9] px-3 py-2 font-sans text-[10px] text-[#4f142b] has-[:checked]:border-[#6e1d3b] has-[:checked]:bg-[#f4d7e0]">
					<input class="accent-[#6e1d3b]" type="radio" name="attendance" value="Tidak hadir" />
					<span>tidak hadir</span>
				</label>
			</div>
		</fieldset>

		<div>
			<label for="guest-message" class="mb-1 block font-sans text-[10px] font-medium text-[#4f142b]">
				Kartu ucapan
			</label>
			<textarea
				id="guest-message"
				name="message"
				rows="3"
				maxlength="500"
				required
				class="w-full resize-y rounded-sm border border-[#c4a252]/70 bg-[#fff7f9] px-3 py-2 font-sans text-xs leading-relaxed text-[#4f142b] outline-none transition placeholder:text-[#8c4059]/60 focus:border-[#6e1d3b] focus:ring-2 focus:ring-[#c4a252]/40"
				placeholder="Tuliskan doa dan ucapan..."
			></textarea>
		</div>

		<button
			type="submit"
			class="w-full rounded-full border border-[#6e1d3b] bg-[#6e1d3b] px-4 py-2.5 font-sans text-[10px] font-medium uppercase tracking-[0.16em] text-[#fff7f9] transition hover:bg-[#4f142b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6e1d3b]"
		>
			Kirim
		</button>
	</form>
</section>
