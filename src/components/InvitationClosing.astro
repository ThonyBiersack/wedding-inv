		loading="lazy"
		class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
	/>
	<!-- Luxury Gradient Overlay -->
	<div
		aria-hidden="true"
		class="absolute inset-0 -z-10 bg-gradient-to-b from-[#241018]/85 via-[#241018]/50 to-[#241018]/92"
