---
// Google Calendar & Maps URL helpers
const calendarUrl =
	"https://calendar.google.com/calendar/render?action=TEMPLATE&text=Pernikahan+Anggi+%26+Asep&dates=20261115T010000Z/20261115T070000Z&details=Akad+Nikah+(08.00+WIB)+dan+Resepsi+(09.00+WIB)+Anggi+%26+Asep.&location=Kediaman+Mempelai+Wanita";
const mapsUrl = "https://maps.app.goo.gl/cC9PHa31hUaMxYqK6";
---

<section
	class="w-full bg-[#fff7f9]/45 p-4 sm:p-6"
	aria-labelledby="events-heading"
>
	<h2
		id="events-heading"
		class="text-center font-sans text-[10px] font-semibold uppercase tracking-[0.28em] text-[#a37d2c] sm:text-xs"
	>
		Wedding Agenda
	</h2>

	<!-- UNIFIED COUNTING DAYS & CALENDAR CARD (MAROON & GOLD) -->
	<div
		class="relative mt-5 overflow-hidden rounded-2xl border border-[#c4a252]/70 bg-gradient-to-b from-[#4f142b] via-[#5c1731] to-[#3a0d1e] p-5 sm:p-7 shadow-lg text-[#e4d3a0]"
	>
		<!-- Background Floral Watermark Corner Accents -->
		<div
			class="pointer-events-none absolute -top-6 -right-6 h-24 w-24 opacity-25"
		>
			<svg
				viewBox="0 0 100 100"
				fill="none"
				stroke="#c4a252"
				stroke-width="1.2"
			>
				<path
					d="M50 10 C60 30 70 30 90 50 C70 70 70 70 50 90 C30 70 30 70 10 50 C30 30 40 30 50 10 Z"
				></path>
				<circle cx="50" cy="50" r="16"></circle>
				<path d="M20 20 Q50 35 80 20"></path>
				<path d="M20 80 Q50 65 80 80"></path>
			</svg>
		</div>
		<div
			class="pointer-events-none absolute -bottom-6 -left-6 h-24 w-24 opacity-25 rotate-180"
		>
			<svg
				viewBox="0 0 100 100"
				fill="none"
				stroke="#c4a252"
				stroke-width="1.2"
			>
				<path
					d="M50 10 C60 30 70 30 90 50 C70 70 70 70 50 90 C30 70 30 70 10 50 C30 30 40 30 50 10 Z"
				></path>
				<circle cx="50" cy="50" r="16"></circle>
				<path d="M20 20 Q50 35 80 20"></path>
				<path d="M20 80 Q50 65 80 80"></path>
			</svg>
		</div>

		<!-- Title: Counting Days -->
		<div class="text-center relative z-10 mb-4">
			<span
				class="block font-script text-3xl sm:text-4xl text-[#f4d7e0] leading-none drop-shadow-xs"
			>
				Counting
			</span>
			<span
				class="block font-serif text-lg sm:text-xl uppercase tracking-[0.22em] text-[#c4a252] -mt-1 sm:-mt-1.5 font-medium"
			>
				Days
			</span>
		</div>

		<!-- Ornate Filigree Frame for Countdown -->
		<div
			class="relative mx-auto max-w-[290px] sm:max-w-xs rounded-xl border border-[#c4a252]/60 bg-[#3a0d1e]/60 px-4 py-4 sm:px-5 sm:py-5 shadow-inner"
		>
			<!-- Corner Filigree Ornaments -->
			<div
				class="pointer-events-none absolute top-1 left-1 h-4 w-4 border-t-2 border-l-2 border-[#c4a252]/80 rounded-tl-sm"
			>
			</div>
			<div
				class="pointer-events-none absolute top-1 right-1 h-4 w-4 border-t-2 border-r-2 border-[#c4a252]/80 rounded-tr-sm"
			>
			</div>
			<div
				class="pointer-events-none absolute bottom-1 left-1 h-4 w-4 border-b-2 border-l-2 border-[#c4a252]/80 rounded-bl-sm"
			>
			</div>
			<div
				class="pointer-events-none absolute bottom-1 right-1 h-4 w-4 border-b-2 border-r-2 border-[#c4a252]/80 rounded-br-sm"
			>
			</div>

			<!-- Center Crests -->
			<div
				class="pointer-events-none absolute -top-1.5 left-1/2 -translate-x-1/2 bg-[#3a0d1e] px-2 text-[#c4a252] text-[9px] font-serif"
			>
				✦ ❖ ✦
			</div>

			<!-- Countdown Numbers -->
			<div
				id="wedding-countdown"
				data-target="2026-11-15T08:00:00+07:00"
				class="flex items-center justify-center gap-1.5 sm:gap-2 text-[#e4d3a0] mt-1"
			>
				<div
					class="flex flex-col items-center min-w-[42px] sm:min-w-[48px]"
				>
					<span
						data-days
						class="font-serif text-xl sm:text-2xl font-bold leading-none text-[#fff0f4] drop-shadow-xs"
						>00</span
					>
					<span
						class="mt-1 font-sans text-[8px] uppercase tracking-wider text-[#c4a252]/90 sm:text-[9px]"
						>Hari</span
					>
				</div>
				<span
					class="font-serif text-base sm:text-lg text-[#c4a252]/70 -mt-3.5"
					>:</span
				>
				<div
					class="flex flex-col items-center min-w-[42px] sm:min-w-[48px]"
				>
					<span
						data-hours
						class="font-serif text-xl sm:text-2xl font-bold leading-none text-[#fff0f4] drop-shadow-xs"
						>00</span
					>
					<span
						class="mt-1 font-sans text-[8px] uppercase tracking-wider text-[#c4a252]/90 sm:text-[9px]"
						>Jam</span
					>
				</div>
				<span
					class="font-serif text-base sm:text-lg text-[#c4a252]/70 -mt-3.5"
					>:</span
				>
				<div
					class="flex flex-col items-center min-w-[42px] sm:min-w-[48px]"
				>
					<span
						data-minutes
						class="font-serif text-xl sm:text-2xl font-bold leading-none text-[#fff0f4] drop-shadow-xs"
						>00</span
					>
					<span
						class="mt-1 font-sans text-[8px] uppercase tracking-wider text-[#c4a252]/90 sm:text-[9px]"
						>Menit</span
					>
				</div>
				<span
					class="font-serif text-base sm:text-lg text-[#c4a252]/70 -mt-3.5"
					>:</span
				>
				<div
					class="flex flex-col items-center min-w-[42px] sm:min-w-[48px]"
				>
					<span
						data-seconds
						class="font-serif text-xl sm:text-2xl font-bold leading-none text-[#fff0f4] drop-shadow-xs"
						>00</span
					>
					<span
						class="mt-1 font-sans text-[8px] uppercase tracking-wider text-[#c4a252]/90 sm:text-[9px]"
						>Detik</span
					>
				</div>
			</div>

			<!-- Quick Button: Add to Calendar inside frame -->
			<div
				class="mt-3.5 flex justify-center pt-2.5 border-t border-[#c4a252]/30"
			>
				<a
					href={calendarUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 rounded-full border border-[#c4a252]/80 bg-[#c4a252]/15 px-3.5 py-1 font-sans text-[9px] font-medium tracking-wider text-[#e4d3a0] shadow-2xs backdrop-blur-xs transition hover:bg-[#c4a252]/30 hover:border-[#e4d3a0] hover:text-[#fff0f4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#c4a252]"
				>
					<svg
						class="h-3 w-3 text-[#c4a252]"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					>
						<rect x="3" y="4" width="18" height="18" rx="2" ry="2"
						></rect>
						<line x1="16" y1="2" x2="16" y2="6"></line>
						<line x1="8" y1="2" x2="8" y2="6"></line>
						<line x1="3" y1="10" x2="21" y2="10"></line>
					</svg>
					<span>Add to Calendar</span>
				</a>
			</div>
		</div>

		<!-- Calendar Grid with Watermark NOV 2026 (No separate month header) -->
		<div class="relative mt-5 mx-auto max-w-[270px] sm:max-w-[290px]">
			<!-- Watermark NOV 2026 behind dates -->
			<div
				class="pointer-events-none absolute inset-0 flex items-center justify-center select-none"
				aria-hidden="true"
			>
				<span
					class="font-serif text-4xl sm:text-5xl font-bold tracking-widest text-[#c4a252]/12"
				>
					NOV 2026
				</span>
			</div>

			<!-- Weekday Names -->
			<div
				class="relative grid grid-cols-7 gap-1 text-center font-serif italic text-[11px] sm:text-xs text-[#c4a252] pb-2 border-b border-[#c4a252]/30"
			>
				<span>Min</span>
				<span>Sen</span>
				<span>Sel</span>
				<span>Rab</span>
				<span>Kam</span>
				<span>Jum</span>
				<span>Sab</span>
			</div>

			<!-- Dates Grid (November 2026 starts on Sunday = Min) -->
			<div
				class="relative grid grid-cols-7 gap-y-1.5 gap-x-1 pt-2.5 text-center font-serif text-xs sm:text-[13px] text-[#e4d3a0]"
			>
				<!-- Row 1: 1 to 7 -->
				<span class="py-1">1</span>
				<span class="py-1">2</span>
				<span class="py-1">3</span>
				<span class="py-1">4</span>
				<span class="py-1">5</span>
				<span class="py-1">6</span>
				<span class="py-1">7</span>

				<!-- Row 2: 8 to 14 -->
				<span class="py-1">8</span>
				<span class="py-1">9</span>
				<span class="py-1">10</span>
				<span class="py-1">11</span>
				<span class="py-1">12</span>
				<span class="py-1">13</span>
				<span class="py-1">14</span>

				<!-- Row 3: 15 (Wedding Date) to 21 -->
				<div class="relative flex items-center justify-center py-0.5">
					<div
						class="relative flex h-7 w-7 items-center justify-center"
					>
						<!-- Heart Badge in Gold -->
						<svg
							class="absolute inset-0 h-full w-full text-[#c4a252] drop-shadow-[0_2px_5px_rgba(0,0,0,0.5)] transition-transform hover:scale-110"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path
								d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
							></path>
						</svg>
						<span
							class="relative font-serif text-[11px] sm:text-xs font-bold text-[#4f142b] z-10 pt-0.5"
						>
							15
						</span>
					</div>
				</div>
				<span class="py-1">16</span>
				<span class="py-1">17</span>
				<span class="py-1">18</span>
				<span class="py-1">19</span>
				<span class="py-1">20</span>
				<span class="py-1">21</span>

				<!-- Row 4: 22 to 28 -->
				<span class="py-1">22</span>
				<span class="py-1">23</span>
				<span class="py-1">24</span>
				<span class="py-1">25</span>
				<span class="py-1">26</span>
				<span class="py-1">27</span>
				<span class="py-1">28</span>

				<!-- Row 5: 29 to 30 -->
				<span class="py-1">29</span>
				<span class="py-1">30</span>
				<span class="py-1 opacity-0 pointer-events-none"></span>
				<span class="py-1 opacity-0 pointer-events-none"></span>
				<span class="py-1 opacity-0 pointer-events-none"></span>
				<span class="py-1 opacity-0 pointer-events-none"></span>
				<span class="py-1 opacity-0 pointer-events-none"></span>
			</div>
		</div>

		<!-- Divider Ornamen Emas Pemisah Kalender & Sesi Acara -->
		<div class="relative my-7 flex items-center justify-center">
			<div aria-hidden="true" class="h-px w-full bg-[#c4a252]/30"></div>
			<div
				class="absolute bg-[#3a0d1e] px-4 font-serif text-xs text-[#c4a252]"
			>
				✦ ❖ ✦
			</div>
		</div>

		<!-- Sesi 1: Akad Nikah -->
		<div class="flex flex-col items-center">
			<!-- SVG Icon Cincin Akad -->
			<div
				class="flex h-11 w-11 items-center justify-center rounded-full border border-[#c4a252]/70 bg-[#3a0d1e] text-[#c4a252] shadow-xs"
			>
				<svg
					class="h-5 w-5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="9" cy="13" r="4.5"></circle>
					<circle cx="15" cy="13" r="4.5"></circle>
					<path d="M12 8.5l1-2.5h2l1 2.5"></path>
				</svg>
			</div>

			<h3
				class="mt-3 font-serif text-lg font-medium text-[#fff0f4] sm:text-xl"
			>
				Akad Nikah
			</h3>
			<p
				class="mt-1 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-[#c4a252]"
			>
				Pukul 08.00 WIB - 09.00 WIB
			</p>
			<p class="mt-1 font-sans text-[11px] text-[#f4d7e0]/90">
				Kediaman Mempelai Wanita
			</p>
		</div>

		<!-- Sub-divider Sesi -->
		<div class="relative my-6 flex items-center justify-center">
			<div aria-hidden="true" class="h-px w-2/3 bg-[#c4a252]/25"></div>
			<div
				class="absolute bg-[#3a0d1e] px-3 font-serif text-xs text-[#c4a252]/70"
			>
				✦ &amp; ✦
			</div>
		</div>

		<!-- Sesi 2: Resepsi Pernikahan -->
		<div class="flex flex-col items-center">
			<!-- SVG Icon Resepsi / Toast -->
			<div
				class="flex h-11 w-11 items-center justify-center rounded-full border border-[#c4a252]/70 bg-[#3a0d1e] text-[#c4a252] shadow-xs"
			>
				<svg
					class="h-5 w-5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M8 22h8"></path>
					<path d="M12 15v7"></path>
					<path
						d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5z"
					></path>
					<path d="M12 5V2"></path>
				</svg>
			</div>

			<h3
				class="mt-3 font-serif text-lg font-medium text-[#fff0f4] sm:text-xl"
			>
				Resepsi Pernikahan
			</h3>
			<p
				class="mt-1 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-[#c4a252]"
			>
				Pukul 09.00 WIB - Selesai
			</p>
			<p class="mt-1 font-sans text-[11px] text-[#f4d7e0]/90">
				Kediaman Mempelai Wanita
			</p>
		</div>

		<!-- Action Button: Google Maps -->
		<div
			class="mt-7 pt-4 border-t border-[#c4a252]/30 flex items-center justify-center"
		>
			<!-- Tombol Lihat Lokasi / Google Maps -->
			<a
				href={mapsUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 rounded-full border border-[#c4a252] bg-[#c4a252] px-6 py-2.5 font-sans text-[10px] font-semibold uppercase tracking-[0.14em] text-[#4f142b] shadow-sm transition hover:bg-[#e4d3a0] hover:border-[#e4d3a0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#c4a252]"
			>
				<svg
					class="h-3.5 w-3.5 text-[#4f142b]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
					></path>
					<circle cx="12" cy="10" r="3"></circle>
				</svg>
				<span>Buka Google Maps</span>
			</a>
		</div>
	</div>
</section>

<script>
	const countdownContainer = document.querySelector("#wedding-countdown");
	if (countdownContainer) {
		const targetAttr = countdownContainer.getAttribute("data-target");
		const targetDate = targetAttr ? new Date(targetAttr).getTime() : 0;

		const daysEl = countdownContainer.querySelector("[data-days]");
		const hoursEl = countdownContainer.querySelector("[data-hours]");
		const minutesEl = countdownContainer.querySelector("[data-minutes]");
		const secondsEl = countdownContainer.querySelector("[data-seconds]");

		const pad = (num: number) => String(Math.max(0, num)).padStart(2, "0");

		const updateCountdown = () => {
			const now = new Date().getTime();
			const difference = targetDate - now;

			if (difference <= 0) {
				if (daysEl) daysEl.textContent = "00";
				if (hoursEl) hoursEl.textContent = "00";
				if (minutesEl) minutesEl.textContent = "00";
				if (secondsEl) secondsEl.textContent = "00";
				return;
			}

			const days = Math.floor(difference / (1000 * 60 * 60 * 24));
			const hours = Math.floor(
				(difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
			);
			const minutes = Math.floor(
				(difference % (1000 * 60 * 60)) / (1000 * 60),
			);
			const seconds = Math.floor((difference % (1000 * 60)) / 1000);

			if (daysEl) daysEl.textContent = pad(days);
			if (hoursEl) hoursEl.textContent = pad(hours);
			if (minutesEl) minutesEl.textContent = pad(minutes);
			if (secondsEl) secondsEl.textContent = pad(seconds);
		};

		updateCountdown();
		setInterval(updateCountdown, 1000);
	}
</script>
