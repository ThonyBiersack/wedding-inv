---
// Google Calendar & Maps URL helpers
const calendarUrl =
	"https://calendar.google.com/calendar/render?action=TEMPLATE&text=Pernikahan+Anggi+%26+Asep&dates=20261115T010000Z/20261115T070000Z&details=Akad+Nikah+(08.00+WIB)+dan+Resepsi+(09.00+WIB)+Anggi+%26+Asep.&location=Kediaman+Mempelai+Wanita";
const mapsUrl = "https://maps.app.goo.gl/cC9PHa31hUaMxYqK6";
---

<section
	class="w-full bg-[#fff7f9]/45 p-4 sm:p-6"
	aria-labelledby="events-heading"
>
	<h2
		id="events-heading"
		class="text-center font-sans text-[10px] font-semibold uppercase tracking-[0.28em] text-[#6e1d3b] sm:text-xs"
	>
		Waktu &amp; Tempat
	</h2>
	<p class="mt-1 text-center font-serif text-xs italic text-[#c4a252] sm:text-sm">
		Wedding Agenda &amp; Location
	</p>

	<!-- Single Unified Frame -->
	<div
		class="relative mt-5 rounded-2xl border border-[#c4a252]/60 bg-[#fff7f9]/70 p-5 text-center shadow-sm sm:p-7"
	>
		<!-- Header: Tanggal Acara -->
		<div class="inline-flex items-center gap-2 rounded-full border border-[#c4a252]/60 bg-[#f4d7e0]/60 px-4 py-1.5 shadow-2xs">
			<svg class="h-3.5 w-3.5 text-[#6e1d3b]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
				<line x1="16" y1="2" x2="16" y2="6"></line>
				<line x1="8" y1="2" x2="8" y2="6"></line>
				<line x1="3" y1="10" x2="21" y2="10"></line>
			</svg>
			<span class="font-sans text-[10px] font-semibold uppercase tracking-[0.16em] text-[#4f142b] sm:text-xs">
				Minggu, 15 November 2026
			</span>
		</div>

		<!-- Countdown Timer -->
		<div
			id="wedding-countdown"
			data-target="2026-11-15T08:00:00+07:00"
			class="mt-5 grid grid-cols-4 gap-2 sm:gap-3 max-w-[280px] sm:max-w-xs mx-auto"
		>
			<div class="flex flex-col items-center rounded-xl border border-[#c4a252]/50 bg-[#fff7f9]/90 py-2.5 px-1 shadow-2xs">
				<span data-days class="font-serif text-lg font-bold text-[#6e1d3b] sm:text-2xl leading-none">00</span>
				<span class="mt-1 font-sans text-[9px] uppercase tracking-wider text-[#4f142b]/80 sm:text-[10px]">Hari</span>
			</div>
			<div class="flex flex-col items-center rounded-xl border border-[#c4a252]/50 bg-[#fff7f9]/90 py-2.5 px-1 shadow-2xs">
				<span data-hours class="font-serif text-lg font-bold text-[#6e1d3b] sm:text-2xl leading-none">00</span>
				<span class="mt-1 font-sans text-[9px] uppercase tracking-wider text-[#4f142b]/80 sm:text-[10px]">Jam</span>
			</div>
			<div class="flex flex-col items-center rounded-xl border border-[#c4a252]/50 bg-[#fff7f9]/90 py-2.5 px-1 shadow-2xs">
				<span data-minutes class="font-serif text-lg font-bold text-[#6e1d3b] sm:text-2xl leading-none">00</span>
				<span class="mt-1 font-sans text-[9px] uppercase tracking-wider text-[#4f142b]/80 sm:text-[10px]">Menit</span>
			</div>
			<div class="flex flex-col items-center rounded-xl border border-[#c4a252]/50 bg-[#fff7f9]/90 py-2.5 px-1 shadow-2xs">
				<span data-seconds class="font-serif text-lg font-bold text-[#6e1d3b] sm:text-2xl leading-none">00</span>
				<span class="mt-1 font-sans text-[9px] uppercase tracking-wider text-[#4f142b]/80 sm:text-[10px]">Detik</span>
			</div>
		</div>

		<!-- Sesi 1: Akad Nikah -->
		<div class="mt-7 flex flex-col items-center">
			<!-- SVG Icon Cincin Akad -->
			<div class="flex h-11 w-11 items-center justify-center rounded-full border border-[#c4a252]/70 bg-[#f4d7e0] text-[#6e1d3b] shadow-xs">
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="9" cy="13" r="4.5"></circle>
					<circle cx="15" cy="13" r="4.5"></circle>
					<path d="M12 8.5l1-2.5h2l1 2.5"></path>
				</svg>
			</div>

			<h3 class="mt-3 font-serif text-lg font-medium text-[#4f142b] sm:text-xl">
				Akad Nikah
			</h3>
			<p class="mt-1 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-[#6e1d3b]">
				Pukul 08.00 WIB - Selesai
			</p>
			<p class="mt-1 font-sans text-[11px] text-[#4f142b]">
				Kediaman Mempelai Wanita
			</p>
		</div>

		<!-- Divider Pemisah dengan Ornamen -->
		<div class="relative my-6 flex items-center justify-center">
			<div aria-hidden="true" class="h-px w-full bg-[#c4a252]/40"></div>
			<div class="absolute bg-[#fff7f9] px-3 font-serif text-xs text-[#c4a252]">
				✦ &amp; ✦
			</div>
		</div>

		<!-- Sesi 2: Resepsi Pernikahan -->
		<div class="flex flex-col items-center">
			<!-- SVG Icon Resepsi / Toast -->
			<div class="flex h-11 w-11 items-center justify-center rounded-full border border-[#c4a252]/70 bg-[#f4d7e0] text-[#6e1d3b] shadow-xs">
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<path d="M8 22h8"></path>
					<path d="M12 15v7"></path>
					<path d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5z"></path>
					<path d="M12 5V2"></path>
				</svg>
			</div>

			<h3 class="mt-3 font-serif text-lg font-medium text-[#4f142b] sm:text-xl">
				Resepsi Pernikahan
			</h3>
			<p class="mt-1 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-[#6e1d3b]">
				Pukul 09.00 WIB - Selesai
			</p>
			<p class="mt-1 font-sans text-[11px] text-[#4f142b]">
				Kediaman Mempelai Wanita
			</p>
		</div>

		<!-- Action Buttons: Google Maps & Kalender -->
		<div class="mt-7 pt-4 border-t border-[#c4a252]/30 flex flex-wrap items-center justify-center gap-2.5">
			<!-- Tombol Lihat Lokasi / Google Maps -->
			<a
				href={mapsUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 rounded-full border border-[#6e1d3b] bg-[#6e1d3b] px-4 py-2 font-sans text-[10px] font-medium uppercase tracking-[0.14em] text-[#fff7f9] shadow-sm transition hover:bg-[#4f142b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6e1d3b]"
			>
				<svg class="h-3.5 w-3.5 text-[#e4d3a0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
					<circle cx="12" cy="10" r="3"></circle>
				</svg>
				<span>Buka Google Maps</span>
			</a>

			<!-- Tombol Simpan ke Kalender -->
			<a
				href={calendarUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 rounded-full border border-[#6e1d3b]/80 bg-[#fff7f9] px-4 py-2 font-sans text-[10px] font-medium uppercase tracking-[0.14em] text-[#6e1d3b] shadow-2xs transition hover:bg-[#6e1d3b] hover:text-[#fff7f9] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6e1d3b]"
			>
				<svg class="h-3.5 w-3.5 text-[#6e1d3b] group-hover:text-[#fff7f9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
					<polyline points="17 21 17 13 7 13 7 21"></polyline>
					<polyline points="7 3 7 8 15 8"></polyline>
				</svg>
				<span>Simpan Kalender</span>
			</a>
		</div>
	</div>
</section>

<script>
	const countdownContainer = document.querySelector("#wedding-countdown");
	if (countdownContainer) {
		const targetAttr = countdownContainer.getAttribute("data-target");
		const targetDate = targetAttr ? new Date(targetAttr).getTime() : 0;

		const daysEl = countdownContainer.querySelector("[data-days]");
		const hoursEl = countdownContainer.querySelector("[data-hours]");
		const minutesEl = countdownContainer.querySelector("[data-minutes]");
		const secondsEl = countdownContainer.querySelector("[data-seconds]");

		const pad = (num: number) => String(Math.max(0, num)).padStart(2, "0");

		const updateCountdown = () => {
			const now = new Date().getTime();
			const difference = targetDate - now;

			if (difference <= 0) {
				if (daysEl) daysEl.textContent = "00";
				if (hoursEl) hoursEl.textContent = "00";
				if (minutesEl) minutesEl.textContent = "00";
				if (secondsEl) secondsEl.textContent = "00";
				return;
			}

			const days = Math.floor(difference / (1000 * 60 * 60 * 24));
			const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
			const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
			const seconds = Math.floor((difference % (1000 * 60)) / 1000);

			if (daysEl) daysEl.textContent = pad(days);
			if (hoursEl) hoursEl.textContent = pad(hours);
			if (minutesEl) minutesEl.textContent = pad(minutes);
			if (secondsEl) secondsEl.textContent = pad(seconds);
		};

		updateCountdown();
		setInterval(updateCountdown, 1000);
	}
</script>
