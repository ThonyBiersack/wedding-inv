<section
	class="w-full bg-[#fff7f9]/45 p-4 sm:p-6"
	aria-labelledby="profiles-heading"
>
	<h2
		id="profiles-heading"
		class="font-sans text-[10px] font-semibold uppercase tracking-[0.28em] text-[#6e1d3b] sm:text-xs"
	>
		Profil Mempelai
	</h2>
	<p class="mt-1 font-serif text-xs italic text-[#c4a252] sm:text-sm">
		The Happy Couple
	</p>

	<!-- Single unified frame for both bride & groom -->
	<div
		class="relative mt-5 rounded-2xl border border-[#c4a252]/60 bg-[#fff7f9]/70 p-4 sm:p-6 shadow-sm"
	>
		<div class="grid grid-cols-2 gap-3 sm:gap-6 items-start">
			<!-- Mempelai Wanita -->
			<div class="flex flex-col items-center text-center">
				<div class="relative w-full aspect-[3/4] max-w-[180px] overflow-hidden rounded-t-full rounded-b-lg border-2 border-[#c4a252]/70 shadow-md">
					<img
						src="/photo/IMG_20261014_194238.jpg"
						alt="Rizva Anggi Rizwati, mempelai wanita"
						loading="lazy"
						class="h-full w-full object-cover object-center transition duration-300 hover:scale-105"
					/>
				</div>
				<p class="mt-3 font-sans text-[9px] font-semibold uppercase tracking-[0.2em] text-[#6e1d3b]">
					Mempelai Wanita
				</p>
				<h3 class="mt-1 text-base font-normal leading-tight text-[#4f142b] sm:text-xl">
					Rizva Anggi Rizwati
				</h3>
				<div aria-hidden="true" class="my-2 h-px w-8 bg-[#c4a252]/60"></div>
				<p class="font-sans text-[10px] leading-relaxed text-[#6e1d3b] sm:text-xs">
					Putri kedua dari<br />
					<span class="font-medium text-[#4f142b]">Bpk. Jufri Effendi</span><br />
					&amp; <span class="font-medium text-[#4f142b]">Ibu Watti Mulyati</span>
				</p>
			</div>

			<!-- Mempelai Pria -->
			<div class="flex flex-col items-center text-center">
				<div class="relative w-full aspect-[3/4] max-w-[180px] overflow-hidden rounded-t-full rounded-b-lg border-2 border-[#c4a252]/70 shadow-md">
					<img
						src="/photo/IMG-20261018-WA0013.jpg"
						alt="Asep Hidayat, mempelai pria"
						loading="lazy"
						class="h-full w-full object-cover object-center transition duration-300 hover:scale-105"
					/>
				</div>
				<p class="mt-3 font-sans text-[9px] font-semibold uppercase tracking-[0.2em] text-[#6e1d3b]">
					Mempelai Pria
				</p>
				<h3 class="mt-1 text-base font-normal leading-tight text-[#4f142b] sm:text-xl">
					Asep Hidayat
				</h3>
				<div aria-hidden="true" class="my-2 h-px w-8 bg-[#c4a252]/60"></div>
				<p class="font-sans text-[10px] leading-relaxed text-[#6e1d3b] sm:text-xs">
					Putra pertama dari<br />
					<span class="font-medium text-[#4f142b]">Bpk. Junaedi</span><br />
					&amp; <span class="font-medium text-[#4f142b]">Ibu Murni</span>
				</p>
			</div>
		</div>

		<!-- Aksen penghubung di tengah frame -->
		<div
			aria-hidden="true"
			class="absolute left-1/2 top-[35%] -translate-x-1/2 -translate-y-1/2 flex h-8 w-8 items-center justify-center rounded-full border border-[#c4a252] bg-[#f4d7e0] font-serif text-sm italic font-medium text-[#6e1d3b] shadow-sm"
		>
			&amp;
		</div>
	</div>
</section>
