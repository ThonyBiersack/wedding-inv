<section
	class="w-full bg-[#fff7f9]/45 p-4 sm:p-6"
	aria-labelledby="profiles-heading"
>
	<h2
		id="profiles-heading"
		class="font-sans text-[10px] font-semibold uppercase tracking-[0.28em] text-[#a37d2c] sm:text-xs"
	>
		Bride &amp; Groom
	</h2>

	<!-- Single unified frame for both bride & groom (Maroon & Gold) -->
	<div
		class="relative mt-5 overflow-hidden rounded-2xl border border-[#c4a252]/70 bg-gradient-to-b from-[#4f142b] via-[#5c1731] to-[#3a0d1e] p-4 sm:p-6 shadow-lg text-[#e4d3a0]"
	>
		<!-- Background Floral Watermark Corner Accents -->
		<div class="pointer-events-none absolute -top-5 -right-5 h-20 w-20 opacity-20">
			<svg viewBox="0 0 100 100" fill="none" stroke="#c4a252" stroke-width="1.2">
				<path d="M50 10 C60 30 70 30 90 50 C70 70 70 70 50 90 C30 70 30 70 10 50 C30 30 40 30 50 10 Z" />
				<circle cx="50" cy="50" r="16" />
				<path d="M20 20 Q50 35 80 20" />
				<path d="M20 80 Q50 65 80 80" />
			</svg>
		</div>
		<div class="pointer-events-none absolute -bottom-5 -left-5 h-20 w-20 opacity-20 rotate-180">
			<svg viewBox="0 0 100 100" fill="none" stroke="#c4a252" stroke-width="1.2">
				<path d="M50 10 C60 30 70 30 90 50 C70 70 70 70 50 90 C30 70 30 70 10 50 C30 30 40 30 50 10 Z" />
				<circle cx="50" cy="50" r="16" />
				<path d="M20 20 Q50 35 80 20" />
				<path d="M20 80 Q50 65 80 80" />
			</svg>
		</div>

		<div class="relative z-10 grid grid-cols-2 gap-3 sm:gap-6 items-start">
			<!-- Mempelai Wanita -->
			<div class="flex flex-col items-center text-center">
				<div class="relative w-full aspect-[3/4] max-w-[180px] overflow-hidden rounded-t-full rounded-b-lg border-2 border-[#c4a252] shadow-md ring-2 ring-[#c4a252]/60 ring-offset-2 ring-offset-[#4f142b]">
					<img
						src="/photo/thumb/IMG_20261014_194238.webp"
						decoding="async"
						alt="Rizva Anggi Rizwati, mempelai wanita"
						loading="lazy"
						class="h-full w-full object-cover object-center transition duration-300 hover:scale-105"
					/>
				</div>
				<p class="mt-3 font-sans text-[9px] font-semibold uppercase tracking-[0.2em] text-[#c4a252]">
					Mempelai Wanita
				</p>
				<h3 class="mt-1 text-base font-normal leading-tight text-[#fff0f4] sm:text-xl">
					Rizva Anggi Rizwati
				</h3>
				<div aria-hidden="true" class="my-2 h-px w-8 bg-[#c4a252]/60"></div>
				<p class="font-sans text-[10px] leading-relaxed text-[#e4d3a0]/85 sm:text-xs">
					Putri kedua dari<br />
					<span class="font-medium text-[#fff0f4]">Bpk. Jufri Effendi</span><br />
					&amp; <span class="font-medium text-[#fff0f4]">Ibu Watti Mulyati</span>
				</p>
			</div>

			<!-- Mempelai Pria -->
			<div class="flex flex-col items-center text-center">
				<div class="relative w-full aspect-[3/4] max-w-[180px] overflow-hidden rounded-t-full rounded-b-lg border-2 border-[#c4a252] shadow-md ring-2 ring-[#c4a252]/60 ring-offset-2 ring-offset-[#4f142b]">
					<img
						src="/photo/thumb/IMG-20261018-WA0013.webp"
						decoding="async"
						alt="Asep Hidayat, mempelai pria"
						loading="lazy"
						class="h-full w-full object-cover object-center transition duration-300 hover:scale-105"
					/>
				</div>
				<p class="mt-3 font-sans text-[9px] font-semibold uppercase tracking-[0.2em] text-[#c4a252]">
					Mempelai Pria
				</p>
				<h3 class="mt-1 text-base font-normal leading-tight text-[#fff0f4] sm:text-xl">
					Asep Hidayat
				</h3>
				<div aria-hidden="true" class="my-2 h-px w-8 bg-[#c4a252]/60"></div>
				<p class="font-sans text-[10px] leading-relaxed text-[#e4d3a0]/85 sm:text-xs">
					Putra pertama dari<br />
					<span class="font-medium text-[#fff0f4]">Bpk. Junaedi</span><br />
					&amp; <span class="font-medium text-[#fff0f4]">Ibu Murni</span>
				</p>
			</div>
		</div>

		<!-- Aksen penghubung di tengah frame -->
		<div
			aria-hidden="true"
			class="absolute left-1/2 top-[35%] -translate-x-1/2 -translate-y-1/2 z-20 flex h-8 w-8 items-center justify-center rounded-full border-2 border-[#c4a252] bg-[#3a0d1e] font-serif text-sm italic font-medium text-[#e4d3a0] shadow-md"
		>
			&amp;
		</div>
	</div>
</section>
